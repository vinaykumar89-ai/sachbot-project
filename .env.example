# ==============================================================================
# SACHBOT ENVIRONMENT VARIABLES & SECRETS TEMPLATE
# ==============================================================================

# Gemini API Key (multimodal vision, extraction, and search grounding)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI Key (Optional: for reverse image search origin tracing)
SERPAPI_KEY=

# Google Fact Check Tools API Key (Optional: for certified IFCN registry lookups)
GOOGLE_FACTCHECK_API_KEY=

# CORS Configuration (comma-separated origins, or '*' for open access)
# Examples:
# ALLOWED_ORIGINS=https://sachbot.pages.dev,http://localhost:5173
ALLOWED_ORIGINS=*

# Server Settings
ENVIRONMENT=production
PORT=8001
HOST=0.0.0.0
DATABASE_URL=sqlite:///./sachbot.db
CACHE_EXPIRATION_HOURS=72
