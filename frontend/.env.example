# ==============================================================================
# SACHBOT FRONTEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Option 1: Cloudflare Workers (Fullstack Python Worker + Static Assets)
# Leave VITE_API_BASE_URL empty so all API calls resolve to the same-origin '/api/*'
VITE_API_BASE_URL=

# Option 2: Split Hosting (e.g. Cloudflare Pages + Render / Hugging Face Spaces)
# Set this to your backend service URL:
# VITE_API_BASE_URL=https://sachbot-api.onrender.com
# VITE_API_BASE_URL=https://your-space.hf.space
