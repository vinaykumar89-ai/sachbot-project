{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sachbot",
  "main": "worker.py",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
